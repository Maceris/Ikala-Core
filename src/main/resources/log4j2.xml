<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
	<Properties>
		<Property name="LOG_DIR">logs</Property>
	</Properties>
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n" />
		</Console>
		<RollingFile name="RollingFile"
			fileName="${LOG_DIR}/latest.log"
			filePattern="${LOG_DIR}/%i.log.gz"
			ignoreExceptions="false">
			<PatternLayout
				pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n" />
			<Policies>
				<SizeBasedTriggeringPolicy size="10MB" />
			</Policies>
			<DefaultRolloverStrategy max="5" />
		</RollingFile>
		<!-- Logging threads only queue their events: a slow write to the console or the file, or the
			file rolling over, would otherwise stall the thread that logs, as the render thread does.
			Only a full queue makes them wait. -->
		<Async name="AsyncConsole" bufferSize="8192" blocking="true">
			<AppenderRef ref="Console" />
		</Async>
		<Async name="AsyncFile" bufferSize="8192" blocking="true">
			<AppenderRef ref="RollingFile" />
		</Async>
	</Appenders>
	<Loggers>
		<logger name="org.hibernate" level="WARN" additivity="false">
			<AppenderRef ref="AsyncConsole" />
			<AppenderRef ref="AsyncFile" />
		</logger>
		<logger name="com.ikalagaming" level="${sys:ikala.logLevel:-DEBUG}" additivity="false">
			<AppenderRef ref="AsyncConsole" />
			<AppenderRef ref="AsyncFile" />
		</logger>
		<Root level="ERROR">
			<AppenderRef ref="AsyncConsole" />
			<AppenderRef ref="AsyncFile" />
		</Root>
	</Loggers>
</Configuration>